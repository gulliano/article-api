# Configuration Heroku pour Article API

APP_NAME="Article API"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-app-name.herokuapp.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# Base de données PostgreSQL (fournie par Heroku)
DB_CONNECTION=pgsql
# Les variables DATABASE_URL, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# sont automatiquement configurées par Heroku

# Session et cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Logs
LOG_CHANNEL=errorlog
LOG_LEVEL=error

# Queue
QUEUE_CONNECTION=database

# Mail (optionnel)
MAIL_MAILER=log

# Sanctum (si vous ajoutez l'auth plus tard)
SANCTUM_STATEFUL_DOMAINS=""

# Filesystem
FILESYSTEM_DISK=local